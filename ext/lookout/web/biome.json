{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts", "!src/components/ui", "!dist"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noEmptyBlockStatements": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
